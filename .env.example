# ─────────────────────────────────────────────────────────────
# Azul Clarito Shop — variables de entorno
#
#   1. Copiá este archivo:   cp .env.example .env.local
#   2. Completá los valores en .env.local
#
# .env.local NUNCA se sube a GitHub (está en .gitignore).
# Este archivo (.env.example) sí se sube, pero SOLO con placeholders:
# jamás escribas secretos reales acá.
# ─────────────────────────────────────────────────────────────

# ── Base de datos (Neon / PostgreSQL) ──────────────────────────
# Cadena de conexión de Neon (con pooling). Formato:
#   postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require
DATABASE_URL=
# (Opcional) Conexión directa SIN pooling. Recomendada para las migraciones.
# Si la dejás vacía, las migraciones usan DATABASE_URL.
DATABASE_URL_UNPOOLED=

# ── Autenticación (proveedor por decidir) ──────────────────────
# Secreto largo y aleatorio. Generalo con:  openssl rand -base64 32
AUTH_SECRET=

# ── Emails (aún no conectado) ──────────────────────────────────
RESEND_API_KEY=
# Remitente de los emails, p. ej.  Azul Clarito Shop <tienda@tudominio.com>
EMAIL_FROM=
# Correo donde management recibe el aviso de pedidos nuevos
ADMIN_NOTIFY_EMAIL=

# ── Pagos (aún no conectado) ───────────────────────────────────
# Nombre del proveedor activo (cuando se elija uno)
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_SECRET=

# ── Sitio ──────────────────────────────────────────────────────
# URL pública de la tienda. En Vercel: https://shop.azulclaritocr.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Correo de contacto público (si se deja vacío usa el configurado en src/config/site.ts)
NEXT_PUBLIC_CONTACT_EMAIL=

# ── SOLO desarrollo local ──────────────────────────────────────
# Permite ver /admin en tu computadora SIN iniciar sesión (todavía no hay
# autenticación). Se IGNORA siempre en producción, aunque esté en "true".
# En Vercel NO la definas.
DEV_ADMIN_PREVIEW=true
